generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id            String        @id @default(cuid())
  name          String
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  ledgerEntries LedgerEntry[]
  bills         Bill[]
  expenses      Expense[]
  suppliers     Supplier[]
  purchases     Purchase[]
  members       Membership[]
  products      Product[]
  stores        Store[]

  @@map("organizations")
}

model Store {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  name           String
  phone          String?
  address        String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  ledgerEntries  LedgerEntry[]
  bills          Bill[]
  expenses       Expense[]
  suppliers      Supplier[]
  purchases      Purchase[]
  members        Membership[]
  products       Product[]
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("stores")
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  storeId        String       @map("store_id")
  userId         String       @map("user_id")
  email          String?
  role           String       @default("owner")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([storeId])
  @@map("memberships")
}

model Product {
  id              String       @id @default(cuid())
  name            String
  category        String?
  barcode         String?
  price           Decimal      @db.Decimal(10, 2)
  costPrice       Decimal      @default(0) @map("cost_price") @db.Decimal(10, 2)
  discountPercent Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxPercent      Decimal      @default(0) @map("tax_percent") @db.Decimal(5, 2)
  stock           Int          @default(0)
  minStock        Int          @default(0) @map("min_stock")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organizationId  String       @map("organization_id")
  storeId         String       @map("store_id")
  billItems       BillItem[]
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store           Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, barcode])
  @@index([name])
  @@index([organizationId])
  @@index([storeId])
  @@map("products")
}

model Bill {
  id                       String       @id @default(cuid())
  totalAmount              Decimal      @map("total_amount") @db.Decimal(10, 2)
  discountAmount           Decimal      @map("discount_amount") @db.Decimal(10, 2)
  taxAmount                Decimal      @map("tax_amount") @db.Decimal(10, 2)
  finalAmount              Decimal      @map("final_amount") @db.Decimal(10, 2)
  paymentMethod            String       @map("payment_method")
  createdAt                DateTime     @default(now()) @map("created_at")
  organizationId           String       @map("organization_id")
  storeId                  String       @map("store_id")
  cashierUserId            String?      @map("cashier_user_id")
  customerName             String?      @map("customer_name")
  customerPhone            String?      @map("customer_phone")
  refundReason             String?      @map("refund_reason")
  refundedAt               DateTime?    @map("refunded_at")
  status                   String       @default("completed")
  billDiscountPercent      Decimal      @default(0) @map("bill_discount_percent") @db.Decimal(5, 2)
  billManualDiscountAmount Decimal      @default(0) @map("bill_manual_discount_amount") @db.Decimal(10, 2)
  items                    BillItem[]
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store                    Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  refunds                  Refund[]

  @@index([organizationId])
  @@index([storeId])
  @@index([createdAt])
  @@map("bills")
}

model Refund {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  storeId        String   @map("store_id")
  billId         String   @map("bill_id")
  amount         Decimal  @db.Decimal(10, 2)
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")
  bill           Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([storeId])
  @@map("refunds")
}

model BillItem {
  id             String   @id @default(cuid())
  billId         String   @map("bill_id")
  productId      String   @map("product_id")
  quantity       Int
  price          Decimal  @db.Decimal(10, 2)
  costPrice      Decimal  @default(0) @map("cost_price") @db.Decimal(10, 2)
  discount       Decimal  @db.Decimal(10, 2)
  tax            Decimal  @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  productName    String   @map("product_name")
  createdAt      DateTime @default(now()) @map("created_at")
  organizationId String   @map("organization_id")
  storeId        String   @map("store_id")
  bill           Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])

  @@index([organizationId])
  @@index([storeId])
  @@map("bill_items")
}

model Customer {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  storeId        String        @map("store_id")
  name           String
  phone          String
  balance        Decimal       @default(0) @db.Decimal(10, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  ledgerEntries  LedgerEntry[]
  payments       Payment[]

  @@unique([storeId, phone])
  @@index([storeId])
  @@map("customers")
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  storeId        String   @map("store_id")
  customerId     String   @map("customer_id")
  billId         String?  @map("bill_id")
  amount         Decimal  @db.Decimal(10, 2)
  method         String   @default("cash")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([storeId])
  @@map("payments")
}

model Expense {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  storeId        String       @map("store_id")
  amount         Decimal      @db.Decimal(10, 2)
  category       String
  description    String?
  date           DateTime     @default(now())
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([date])
  @@map("expenses")
}

model LedgerEntry {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  storeId        String       @map("store_id")
  customerId     String       @map("customer_id")
  amount         Decimal      @db.Decimal(10, 2)
  type           String
  note           String?
  date           DateTime     @default(now()) @map("date")
  createdAt      DateTime     @default(now()) @map("created_at")
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([storeId])
  @@index([customerId])
  @@index([date])
}

model Supplier {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  storeId        String         @map("store_id")
  name           String
  phone          String?
  email          String?
  address        String?
  balance        Decimal        @default(0) @db.Decimal(10, 2)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  purchases      Purchase[]
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("suppliers")
}

model Purchase {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  storeId        String       @map("store_id")
  supplierId     String       @map("supplier_id")
  amount         Decimal      @db.Decimal(10, 2)
  status         String       @default("completed")
  note           String?
  createdAt      DateTime     @default(now()) @map("created_at")
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([storeId])
  @@map("purchases")
}
